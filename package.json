{
  "name": "ai-article-website",
  "version": "1.0.0",
  "description": "AI article library with 32 articles, login-gated ZIP downloads and a full admin dashboard",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "reset": "node --disable-warning=ExperimentalWarning scripts/reset.js",
    "test": "node --disable-warning=ExperimentalWarning scripts/smoke-test.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "ai",
    "articles",
    "express",
    "sqlite",
    "ejs"
  ],
  "license": "MIT",
  "dependencies": {
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "method-override": "^3.0.0"
  }
}
